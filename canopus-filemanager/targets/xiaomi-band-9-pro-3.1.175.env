# Rust/private-ABI build selection for this exact firmware target.
# 与 Searchstars/Canopus-Module-BluetoothAudio 的 targets/xiaomi-band-9-pro-3.1.175.env 一致。
RUST_TARGET_FEATURE=target-xiaomi-band-9-pro-3-1-175
RUST_TARGET_TRIPLE=thumbv8m.main-none-eabihf
RUST_TARGET_CPU=cortex-m33
# Band-9 (Band 9 Pro, BES) exposes the same Cortex-M33 FPv5 unit as band-10.
# MODULE_MAX_SIZE=0 表示该 target 暂无项目级体积上限（闭源 target pack 未启用）。
MODULE_MAX_SIZE=0
